# # Server
# PORT=3000
# NODE_ENV=development

# # PostgreSQL connection string
# # Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=postgres://doclyn_user:Krish@localhost:5432/doclyn
# # JWT secrets — CHANGE THESE in production. Use long random strings.
# # Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_ACCESS_SECRET=replace_with_long_random_string_min_32_chars
# JWT_REFRESH_SECRET=replace_with_different_long_random_string_min_32_chars
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# # Bcrypt cost factor (10+ recommended)
# BCRYPT_COST=10

# # Frontend origin for CORS
# FRONTEND_URL=http://localhost:5173

# # Python FastAPI service URL
# PYTHON_ENGINE_URL=http://localhost:8001

# # File storage (local disk now)
# UPLOAD_DIR=/tmp/doclyn/inputs
# OUTPUT_DIR=/tmp/doclyn/outputs

# # Max upload size in bytes (50MB)
# MAX_FILE_BYTES=52428800












# ==============================
# SERVER
# ==============================
PORT=5000
NODE_ENV=development


# ==============================
# MONGODB - LOCAL
# ==============================
MONGO_URI=mongodb://127.0.0.1:27017/doclyn


# ==============================
# POSTGRESQL - LOCAL
# ==============================
DATABASE_URL=postgresql://postgres:krish@127.0.0.1:5432/doclyn


# ==============================
# REDIS
# ==============================
REDIS_URL=redis://127.0.0.1:6379

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=


# ==============================
# JWT
# ==============================
JWT_ACCESS_SECRET=doclyn-development-access-secret-change-this
JWT_REFRESH_SECRET=doclyn-development-refresh-secret-change-this

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_COST=10


# ==============================
# PYTHON PDF SERVICE
# ==============================
PYTHON_SERVICE_URL=http://127.0.0.1:8001